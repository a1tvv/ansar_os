# Скопируй в .env и подставь свои значения. .env читается вручную —
# см. README (в dev проще задать переменные окружения перед запуском).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

# --- Postgres ---
PG_DB=ansar_os
PG_USER=postgres
PG_PASSWORD=postgres
PG_HOST=localhost
PG_PORT=5432
# Если PG_DB не задан — проект временно поднимется на SQLite.
